APP_ENV=development
DATABASE_PATH=/data/kalpi.db
ENCRYPTION_SECRET=replace-with-a-long-random-secret
ENABLE_LIVE_TRADING=false
WEBHOOK_URL=
BROKER_TIMEOUT_SECONDS=10
MAX_ORDER_ATTEMPTS=3
ORDER_POLL_INTERVAL_SECONDS=1
ORDER_POLL_TIMEOUT_SECONDS=20

# Provider application credentials are supplied when connecting a broker.
# Never commit real credentials or access tokens.
